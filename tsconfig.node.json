{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "src/adapters/node/**/*.ts",
    "src/app/**/*.ts",
    "src/config/**/*.ts",
    "src/protocol/*.test.ts",
    "src/router/**/*.ts",
    "tests/**/*.ts",
    "scripts/*.test.ts"
  ],
  "exclude": [
    "tests/cli/**",
    "tests/docs/**",
    "tests/edge/**",
    "tests/exports/**",
    "tests/http/wss_tls_integration_test.ts",
    "tests/http/direct_route_websocket_test.ts",
    "tests/local/**",
    "tests/providers/fixtures/**",
    "tests/providers/local_process_test.ts",
    "tests/release/**"
  ]
}
