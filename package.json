    "version:sync": "node scripts/sync_deno_version.mjs"
  },
  "dependencies": {
    "pg": "8.23.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
